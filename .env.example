# Example values for the Compose network (service names postgres, localstack,
# keycloak). Copy to .env to override the AWS_*, OIDC_* and SQS_* values that
# docker-compose.yml reads. To run the API on the host instead, use localhost
# addresses (see Configuration in README.md). No real secrets belong here.

DATABASE_URL=postgres://postgres:postgres@postgres:5432/betting?sslmode=disable
HTTP_ADDR=:8080
AWS_REGION=us-east-1
AWS_ENDPOINT=http://localstack:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
OIDC_ISSUER_URL=http://localhost:8081/realms/backend
OIDC_JWKS_URL=http://keycloak:8080/realms/backend/protocol/openid-connect/certs
OIDC_AUDIENCE=backend-api
OIDC_PROVIDER_CLAIM=provider_id
SQS_TRANSACTION_QUEUE=wager-transactions.fifo
SQS_TRANSACTION_DLQ=wager-transactions-dlq.fifo
SQS_EVENT_QUEUE=wager-events.fifo
SQS_MAX_RECEIVE_COUNT=5
