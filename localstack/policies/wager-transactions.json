{
  "Version": "2012-10-17",
  "Id": "wager-transactions-access",
  "Statement": [
    {
      "Sid": "ProvidersOnlySendCommands",
      "Effect": "Allow",
      "Principal": { "AWS": "arn:aws:iam::__ACCOUNT__:role/wagering-provider-producer" },
      "Action": ["sqs:SendMessage", "sqs:GetQueueUrl"],
      "Resource": "__QUEUE_ARN__"
    },
    {
      "Sid": "ApplicationConsumesCommands",
      "Effect": "Allow",
      "Principal": { "AWS": "arn:aws:iam::__ACCOUNT__:role/backend-application" },
      "Action": [
        "sqs:ReceiveMessage",
        "sqs:DeleteMessage",
        "sqs:ChangeMessageVisibility",
        "sqs:GetQueueAttributes",
        "sqs:GetQueueUrl"
      ],
      "Resource": "__QUEUE_ARN__"
    }
  ]
}
